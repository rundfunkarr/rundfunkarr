generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TvdbSeries {
  id         Int           @id
  name       String
  germanName String?
  slug       String?
  overview   String?
  aliases    String?       // JSON array stored as string
  firstAired DateTime?
  cachedAt   DateTime      @default(now())
  expiresAt  DateTime
  episodes   TvdbEpisode[]
}

model TvdbEpisode {
  id            Int         @id @default(autoincrement())
  seriesId      Int
  seasonNumber  Int
  episodeNumber Int
  name          String?
  aired         DateTime?
  runtime       Int?
  series        TvdbSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, seasonNumber, episodeNumber])
}

model Download {
  id              String    @id @default(uuid())
  title           String
  url             String
  category        String
  status          String    @default("queued")
  progress        Int       @default(0)
  size            BigInt    @default(0)
  totalSize       BigInt    @default(0)
  downloadedBytes BigInt    @default(0)
  speed           BigInt    @default(0)
  filePath        String?
  error           String?
  priority        Int       @default(0)
  attempts        Int       @default(0)
  nextRetryAt     DateTime?
  mediaMetadata   String?
  warning         String?
  subtitleArtifact String?   // JSON identity of the sidecar created by this download
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([status])
}

model Config {
  key   String @id
  value String
}

model AuthConfig {
  id                Int       @id @default(1)
  enabled           Boolean   @default(false)
  username          String    @default("")
  passwordHash      String    @default("")
  apiKey            String
  revision          String
  failedLogins      Int       @default(0)
  loginBlockedUntil DateTime?
}

model AuthSession {
  tokenHash String   @id
  revision  String
  expiresAt DateTime

  @@index([expiresAt])
}

model GeneratedRuleset {
  id               String   @id @default(uuid())
  topic            String   @unique  // MediathekView topic
  tvdbId           Int
  showName         String
  germanName       String?
  matchingStrategy String   @default("SeasonAndEpisodeNumber")
  filters          String   @default("[{\"attribute\":\"duration\",\"type\":\"GreaterThan\",\"value\":\"15\"}]")
  episodeRegex     String   @default("(?<=[E/])(\\d{2})(?=\\))")
  seasonRegex      String   @default("(?<=[S(])(\\d{2})(?=[/E])")
  titleRegexRules  String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tvdbId])
}

model TopicCategory {
  id        String   @id @default(cuid())
  topic     String   @unique
  category  String   // "movie" | "tv" | "unknown"
  tmdbId    Int?
  cachedAt  DateTime @default(now())

  @@index([topic])
}

model SearchSubscription {
  id String @id @default(uuid())
  name String
  query String
  channel String @default("")
  minMinutes Int @default(0)
  maxMinutes Int @default(0)
  intervalMinutes Int @default(60)
  quality String @default("high")
  action String @default("notify")
  category String @default("default")
  paused Boolean @default(false)
  initialized Boolean @default(false)
  lastCheckedAt DateTime?
  nextCheckAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches SubscriptionMatch[]
  @@index([paused, nextCheckAt])
}

model SubscriptionMatch {
  id String @id @default(uuid())
  subscriptionId String
  sourceKey String
  title String
  topic String
  channel String
  videoUrl String
  websiteUrl String
  duration Int
  state String @default("new")
  downloadId String?
  foundAt DateTime @default(now())
  subscription SearchSubscription @relation(fields:[subscriptionId], references:[id], onDelete:Cascade)
  @@unique([subscriptionId,sourceKey])
  @@index([subscriptionId,state,foundAt])
}
